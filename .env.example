# Don't put CONVEX_DEPLOY_KEY here. The production deploy key lives only in
# GitHub secrets; in this file it would aim every local Convex CLI command,
# including the e2e scripts, at production.

# Playwright (enable Password auth with `npx convex env set E2E_TEST 1`)
E2E_BASE_URL=http://localhost:3100
E2E_ACCOUNT_NAMESPACE=local
E2E_PASSWORD=

# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
